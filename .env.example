# Copy to .env and fill in. Never commit .env.

# LLM via OpenRouter (OpenAI-compatible). Leave LLM_MODEL empty for openai/gpt-6-luna, the measured
# cloud default (docs/decisions/chat-model.md).
OPENROUTER_API_KEY=
LLM_MODEL=

# The local model (Ollama or LM Studio, OpenAI-compatible), used with OFFLINE=1, or online when
# OPENROUTER_API_KEY is empty. Keep both setups here and switch with OFFLINE (#230).
# The measured local model is openai/gpt-oss-20b in LM Studio (http://localhost:1234/v1).
# From inside Docker, use http://host.docker.internal:11434/v1 for an Ollama running on the host.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Sampling temperature, seconds to wait for a model response, and retries on failed calls. Leave empty for 0.2, 60 and 2.
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=

# How long a reasoning model thinks when it sorts a message for the guard and reads the label
# filter from a question: low, medium or high. Leave empty for the model's default (gpt-oss-20b in
# LM Studio then reasons about as briefly as on low). A model that doesn't reason may reject it.
LLM_REASONING_EFFORT=
# The same for writing the answer: low, medium, high, or "default" for the model's default. Leave
# empty for medium: at the default, gpt-oss-20b answered comparisons from memory after one tool
# call (docs/evals/comparisons-2026-10-17.md).
ANSWER_REASONING_EFFORT=
# The same for the source check, which judges each answer against its sources once it has been
# shown: low, medium, high, or "default" for the model's default. Leave empty for medium, which
# caught more claims a cited passage doesn't hold (docs/decisions/answer-check.md).
SOURCE_CHECK_REASONING_EFFORT=

# Decision model: answers typed questions with probabilities over /v1/systemone (#102, #106).
# Online it sorts each message for the guard (#226) and fills the label filter (#290); with
# OFFLINE=1 or without OPENROUTER_API_KEY the chat model does both. Leave DECISION_MODEL empty
# for jev-1.13 on OpenRouter. LOCAL_DECISION_BASE_URL points it at LM Studio 0.4.26 build 4 or newer instead; DECISION_MODEL must then name the decision
# model loaded there, or LM Studio refuses every call and every message is refused. Seconds to wait
# for an answer: leave empty for 10.
DECISION_MODEL=
LOCAL_DECISION_BASE_URL=
DECISION_TIMEOUT_SECONDS=

# Embeddings: "local" (a sentence-transformers model run in the backend) or a cloud model id on
# OpenRouter (e.g. openai/text-embedding-3-small, needs OPENROUTER_API_KEY). The index is built
# with one model and every query must use the same one: rebuild with `python -m molecula.ingest index`.
EMBEDDING_MODEL=local
# The local model when EMBEDDING_MODEL=local. Leave empty for BAAI/bge-m3 (2.3 GB, multilingual;
# docs/decisions/embeddings.md). The index must be rebuilt after a change.
LOCAL_EMBEDDING_MODEL=
# The Hugging Face commit of the local model, a 40-character hash. Leave empty for the bge-m3 commit
# the published index was built with; `python -m molecula.ingest fetch` downloads it and checks its
# weights. With another LOCAL_EMBEDDING_MODEL, set it to that model's commit: `fetch` downloads
# only the pinned bge-m3, and `python -m molecula.ingest index` downloads the other model.
LOCAL_EMBEDDING_MODEL_REVISION=

# Label search: chunks per search (per drug, when a search names several), the cosine similarity
# below which a chunk is dropped, and how much higher a chunk in the question's section groups
# ranks. Leave empty for 5, 0 and 0.15
# (docs/architecture.md, "No score threshold yet" and "ranked by the part of the label").
RETRIEVAL_TOP_K=
RETRIEVAL_MIN_SCORE=
RETRIEVAL_SECTION_GROUP_BOOST=
# How the label search ranks: dense (embeddings), bm25 (keywords) or hybrid (both, merged by
# reciprocal rank fusion). Leave empty for dense, which found the most (docs/decisions/hybrid-search.md).
RETRIEVAL_MODE=

# Chat: model calls per answer (the last one answers without tools) and seconds before an answer
# is stopped. Leave empty for 8 and 180.
CHAT_MAX_STEPS=
CHAT_TIMEOUT_SECONDS=
# The agent's tools: local (the default) or mcp, through the MCP server in the backend (#42). With
# mcp the chat shows no sources list, and the cost limit doesn't count the label-filter calls.
AGENT_TOOLS=

# Limits on POST /chat (#39): questions per client (by IP) per minute and per day, answered with
# 429 and Retry-After over the limit, and what the cloud models may cost per UTC day (US dollars),
# after which the chat answers 503 until midnight UTC. A local model costs nothing and has no cost
# limit. Leave empty for 10, 200 and 2. The evals switch them off (backend/evals/no_limits.py).
CHAT_REQUESTS_PER_MINUTE=
CHAT_REQUESTS_PER_DAY=
DAILY_COST_LIMIT_USD=
# 1 = the backend runs behind a proxy, and the client's IP is the last X-Forwarded-For entry,
# the one the proxy added. Leave at 0 otherwise: any client can write that header.
TRUST_PROXY=0

# openFDA key (optional, raises the daily quota). The backend keeps both keys to itself: at startup
# its log says which are set, never their values.
OPENFDA_API_KEY=

# The backend updates the labels from openFDA every night at LABEL_UPDATE_HOUR (UTC, default 3).
# LABEL_UPDATE_SCHEDULE=0 turns that off, e.g. on a store kept as the eval baseline; with OFFLINE=1
# it never runs. LABEL_UPDATE_BUTTON=1 shows an Update now button on the dashboard and opens its
# route, POST /labels/update; leave it at 0 on a public instance (#342).
LABEL_UPDATE_SCHEDULE=1
LABEL_UPDATE_HOUR=3
LABEL_UPDATE_BUTTON=0

# 1 = never call external APIs (demo and eval mode): the local chat model answers and sorts the
# messages, and answers come only from the local data. 0 = the cloud setup when OPENROUTER_API_KEY
# is set: gpt-6-luna answers, Jev sorts the messages and fills the label filter.
OFFLINE=0

# The GitHub release (store-YYYY-MM-DD) that `python -m molecula.ingest fetch` downloads the built
# store from on a fresh clone. Leave empty for the release this code was written for.
STORE_RELEASE=

# Browser origins allowed to call the backend, as a JSON list. Leave empty for the frontend on http://localhost:3000.
CORS_ORIGINS=

# How close (0 to 1) a supported name must be to an unsupported one to be suggested. Leave empty for 0.8.
NAME_SUGGESTION_CUTOFF=

# Folder with the curated inputs and the built store (build/). Leave empty to use the repo's data/; Docker sets it.
# The usage log goes to runtime/usage.db in the same folder.
DATA_DIR=

# DEBUG, INFO, WARNING or ERROR. Leave empty for INFO, which logs one JSON line per chat request.
LOG_LEVEL=
