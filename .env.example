# Copy to .env and fill in. Never commit .env.

# What a new machine sets

# The cloud setup: gpt-6-luna writes the answers and Jev checks the messages, on OpenRouter.
OPENROUTER_API_KEY=
# 1 = nothing goes out: the local model answers and checks everything. 0 = the cloud setup when
# OPENROUTER_API_KEY is set, the local model otherwise.
OFFLINE=0
# The local model, LM Studio with gpt-oss-20b loaded at 32k context. These values are for a backend
# in Docker; without Docker use http://localhost:1234/v1 (Ollama: port 11434).
LOCAL_LLM_BASE_URL=http://host.docker.internal:1234/v1
LOCAL_LLM_MODEL=openai/gpt-oss-20b
# More OpenRouter models to pick in the settings, next to gpt-6-luna, as a JSON list, e.g.
# ["anthropic/claude-haiku-5.5"]. Only gpt-6-luna and gpt-oss-20b were measured.
LLM_MODELS=

# Tuning: each line shows the default; remove the # to change it

# Models (docs/decisions/chat-model.md)
# LLM_MODEL=openai/gpt-6-luna
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Reasoning effort, low, medium or high, for the message check and the label filter; empty is the
# model's own default. The answer and the source check also take "default".
# LLM_REASONING_EFFORT=
# ANSWER_REASONING_EFFORT=medium
# SOURCE_CHECK_REASONING_EFFORT=medium
# The decision model that checks messages online. LOCAL_DECISION_BASE_URL runs it in LM Studio
# (0.4.26 build 4 or newer); DECISION_MODEL must then name the model loaded there.
# DECISION_MODEL=jev-1.13
# LOCAL_DECISION_BASE_URL=
# DECISION_TIMEOUT_SECONDS=10

# Embeddings: local (bge-m3 in the backend) or google/gemini-embedding-2 for a server too small
# for it, which needs OPENROUTER_API_KEY and OFFLINE=0 (docs/decisions/embeddings.md).
# EMBEDDING_MODEL=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# Empty is the bge-m3 commit the published index was built with.
# LOCAL_EMBEDDING_MODEL_REVISION=

# Label search: passages per search, minimum similarity, ranking mode (dense, bm25 or hybrid).
# The section boost is empty for 0.15 with the local model and 0 with a cloud one.
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0
# RETRIEVAL_SECTION_GROUP_BOOST=
# RETRIEVAL_MODE=dense
# Query translation before the search: off, translate (a German question searched in English) or
# multi_query (the question and 3 rewrites, merged), both written by the chat model.
# QUERY_TRANSLATION=off

# Chat: model calls and seconds per answer, and where the tools come from (local or mcp).
# CHAT_MAX_STEPS=8
# CHAT_TIMEOUT_SECONDS=180
# AGENT_TOOLS=mcp

# Limits on POST /chat: questions per IP per minute and per day, cloud cost per UTC day in USD.
# TRUST_PROXY=1 reads the IP from X-Forwarded-For; only behind a proxy that sets it.
# CHAT_REQUESTS_PER_MINUTE=10
# CHAT_REQUESTS_PER_DAY=200
# DAILY_COST_LIMIT_USD=2
# TRUST_PROXY=0

# Login for a deployed app (#343): Clerk with invite-only sign-up, so only people invited from the
# Clerk Dashboard get in; empty keys leave it off. The backend checks tokens with the instance's public
# key (Dashboard: API keys, JWKS Public Key, on one line) and accepts them only for CORS_ORIGINS.
# Docker Compose passes the other two to the frontend, the publishable key at build time.
# CLERK_JWT_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# The nightly label update from openFDA (UTC hour), online only. Set LABEL_UPDATE_SCHEDULE=0 to
# keep the labels fixed, e.g. before a demo. LABEL_UPDATE_BUTTON=1 shows Update now on the
# dashboard; keep it at 0 on a public instance.
# LABEL_UPDATE_SCHEDULE=1
# LABEL_UPDATE_HOUR=3
# LABEL_UPDATE_BUTTON=0
# Optional: raises openFDA's daily quota for the label update.
# OPENFDA_API_KEY=

# Data and server. STORE_RELEASE and DATA_DIR are empty for the release this code pins and the
# repo's data/ (Docker sets DATA_DIR).
# STORE_RELEASE=
# DATA_DIR=
# CORS_ORIGINS=["http://localhost:3000"]
# The frontend's public address, built into the preview card a shared link shows (#461).
# SITE_URL=http://localhost:3000
# NAME_SUGGESTION_CUTOFF=0.8
# LOG_LEVEL=INFO
