# Copy to .env and fill in. Never commit .env.

# LLM via OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
LLM_MODEL=

# Local models instead (Ollama or LM Studio, OpenAI-compatible). Leave empty to use OpenRouter.
# From inside Docker, use http://host.docker.internal:11434/v1 for an Ollama running on the host.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Embeddings: "local" (sentence-transformers) or a cloud model id
EMBEDDING_MODEL=local

# openFDA key (optional, raises the daily quota)
OPENFDA_API_KEY=

# 1 = never call external APIs (demo and eval mode); answers come only from the local data
OFFLINE=0

# Browser origins allowed to call the backend, as a JSON list. Leave empty for the frontend on http://localhost:3000.
CORS_ORIGINS=

# Folder with the curated inputs and the built store (build/). Leave empty to use the repo's data/; Docker sets it.
DATA_DIR=
